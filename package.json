{
  "name": "front-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend templates monorepo — patterns, best practices, documentation",
  "keywords": [
    "frontend",
    "templates",
    "react",
    "angular",
    "typescript",
    "architecture"
  ],
  "license": "MIT",
  "author": "Your Name <your@email.com>",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm install && pnpm prepare",
    "lint": "eslint packages --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint packages --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "submodule:check": "git submodule foreach 'git status --short && test -z \"$(git status --short)\" || (echo \"Uncommitted changes in $name\" && exit 1)'",
    "submodule:update": "git submodule update --remote --merge",
    "submodule:init": "git submodule update --init --recursive",
    "submodule:add": "node scripts/submodule-add.mjs",
    "new": "node scripts/create-package.mjs",
    "affected": "tsx scripts/check-affected.ts",
    "ci:local": "pnpm format:check && pnpm lint && pnpm submodule:check",
    "setup:protection": "node scripts/setup-branch-protection.mjs",
    "setup:submodules": "node scripts/setup-submodule-coordination.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
